 from functools import lru_cache
 
 from langchain_openai import ChatOpenAI
+from langchain_core.messages import AIMessage
 
 from .config import get_config
 from .models_registry import MODEL_REGISTRY
 
 
+def get_llm_content(response: AIMessage) -> str:
+    """Extract useful content from an LLM response, handling thinking-mode models.
+    
+    Some models (like Qwen thinking mode or Kimi) may return empty content while
+    putting the actual output/reasoning in additional_kwargs['reasoning_content']
+    or response_metadata.
+    """
+    content = response.content or ""
+    
+    # If content is non-empty and not just whitespace, return it
+    if isinstance(content, str) and content.strip():
+        return content
+    
+    # Check additional_kwargs for reasoning_content (Qwen/Kimi thinking mode)
+    ak = getattr(response, "additional_kwargs", {}) or {}
+    reasoning = ak.get("reasoning_content") or ak.get("reasoning_details") or ""
+    if reasoning and isinstance(reasoning, str):
+        return reasoning
+    
+    # Check response_metadata
+    rm = getattr(response, "response_metadata", {}) or {}
+    meta_reasoning = rm.get("reasoning_content") or rm.get("reasoning_details") or ""
+    if meta_reasoning and isinstance(meta_reasoning, str):
+        return meta_reasoning
+    
+    return content if isinstance(content, str) else str(content)
+
+
 @lru_cache(maxsize=None)
 def get_chat_model(role: str, temperature: float = 0.2, max_retries: int = 2) -> ChatOpenAI:
     model_name = MODEL_REGISTRY.get(role)
